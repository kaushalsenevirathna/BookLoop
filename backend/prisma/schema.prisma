// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Represents a university faculty (e.g., "Faculty of Law")
model Faculty {
  id       String    @id @default(uuid())
  name     String    @unique
  subjects Subject[]
  users    User[]
  books    Book[]
}

// Represents a subject area within a faculty (e.g., "Torts" under Law)
model Subject {
  id        String  @id @default(uuid())
  name      String
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])
  books     Book[]
}

// Represents a registered student
model User {
  id              String     @id @default(uuid())
  universityEmail String     @unique
  name            String
  facultyId       String
  faculty         Faculty    @relation(fields: [facultyId], references: [id])
  yearOfStudy     Int?
  isVerified      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  listings        Listing[]  // books this user has donated/listed
  requests        Request[]  // books this user has requested from others
  wishlistItems   Wishlist[] // this user's "notify me" entries
  reports         Report[]   // reports this user has filed
}

// Represents a unique book in the shared catalog
model Book {
  id           String    @id @default(uuid())
  isbn         String?   @unique
  title        String
  author       String
  edition      String?
  printedPrice Decimal?  @db.Decimal(10, 2)
  facultyId    String
  faculty      Faculty   @relation(fields: [facultyId], references: [id])
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id])
  courseCode   String?
  listings     Listing[]
}

enum Condition {
  NEW
  GOOD
  FAIR
  WORN
}

enum PriceType {
  FREE
  DISCOUNTED
}

enum ListingStatus {
  AVAILABLE
  REQUESTED
  GIVEN_AWAY
  FLAGGED
}

// Represents one donor's specific offer of a specific book
model Listing {
  id          String         @id @default(uuid())
  bookId      String
  book        Book           @relation(fields: [bookId], references: [id])
  donorId     String
  donor       User           @relation(fields: [donorId], references: [id])
  condition   Condition
  priceType   PriceType
  listedPrice Decimal?       @db.Decimal(10, 2)
  note        String?
  status      ListingStatus  @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  images      ListingImage[]
  requests    Request[]
  reports     Report[]       // reports filed against this listing
}

// Represents one photo attached to a listing
model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  imageUrl  String
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

// Represents a student's request to receive a specific listing
model Request {
  id                 String        @id @default(uuid())
  listingId          String
  listing            Listing       @relation(fields: [listingId], references: [id])
  requesterId        String
  requester          User          @relation(fields: [requesterId], references: [id])
  status             RequestStatus @default(PENDING)
  donorConfirmed     Boolean       @default(false)
  requesterConfirmed Boolean       @default(false)
  createdAt          DateTime      @default(now())
  completedAt        DateTime?
}

// Represents a "notify me" entry when a user's search returns nothing
model Wishlist {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  bookTitleQuery String                        // free-text search the user typed
  subjectArea    String?                       // optional free-text subject hint
  notified       Boolean  @default(false)       // flips true once a matching book is found and user is told
  createdAt      DateTime @default(now())
}

// Fixed set of allowed report status values
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Represents a user-submitted report against a listing (moderation)
model Report {
  id         String       @id @default(uuid())
  listingId  String
  listing    Listing      @relation(fields: [listingId], references: [id])
  reportedBy String
  reporter   User         @relation(fields: [reportedBy], references: [id])
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Represents a university faculty (e.g., "Faculty of Law")
model Faculty {
  id       String    @id @default(uuid())
  name     String    @unique
  subjects Subject[]
  users    User[]
  books    Book[]
}

// Represents a subject area within a faculty (e.g., "Torts" under Law)
model Subject {
  id        String  @id @default(uuid())
  name      String
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])
  books     Book[]
}

// Represents a registered student
model User {
  id              String    @id @default(uuid())
  universityEmail String    @unique
  name            String
  facultyId       String
  faculty         Faculty   @relation(fields: [facultyId], references: [id])
  yearOfStudy     Int?
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  listings        Listing[] // a user can donate/list many books
}

// Represents a unique book in the shared catalog
model Book {
  id           String    @id @default(uuid())
  isbn         String?   @unique
  title        String
  author       String
  edition      String?
  printedPrice Decimal?  @db.Decimal(10, 2)
  facultyId    String
  faculty      Faculty   @relation(fields: [facultyId], references: [id])
  subjectId    String
  subject      Subject   @relation(fields: [subjectId], references: [id])
  courseCode   String?
  listings     Listing[] // a book can have many listings (copies from different donors)
}

// Fixed set of allowed condition values
enum Condition {
  NEW
  GOOD
  FAIR
  WORN
}

// Fixed set of allowed price type values
enum PriceType {
  FREE
  DISCOUNTED
}

// Fixed set of allowed listing status values
enum ListingStatus {
  AVAILABLE
  REQUESTED
  GIVEN_AWAY
  FLAGGED
}

// Represents one donor's specific offer of a specific book
model Listing {
  id          String        @id @default(uuid())
  bookId      String
  book        Book          @relation(fields: [bookId], references: [id])
  donorId     String
  donor       User          @relation(fields: [donorId], references: [id])
  condition   Condition
  priceType   PriceType
  listedPrice Decimal?      @db.Decimal(10, 2)   // only set if priceType is DISCOUNTED
  note        String?
  status      ListingStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now())
}